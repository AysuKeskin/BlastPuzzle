# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Rr]ecordings/

# Numbered local exports and Unity build backups
/[Bb]uild[0-9]*/
/*_BackUpThisFolder_ButDontShipItWithYourGame/

# Temporary scenes created by Unity Test Runner
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta

# Memory captures
[Mm]emoryCaptures/

# Asset Store tools
[Aa]ssets/AssetStoreTools*

# IDE / editor
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj

# Rider
*.sln.iml

# Visual Studio
.vs/

# OS files
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt

# Gradle
.gradle/

# Android
*.apk
*.aab

# iOS / Xcode
DerivedData/
*.xcworkspace
*.xcuserstate

# Temporary / backup files
*.tmp
*.temp
*.swp
*.swo
*~

# Logs
*.log

# Keep Packages/manifest.json and Packages/packages-lock.json versioned.

# Optional local settings
.env
.env.*
!.env.example
!.env.sample
